NEXTCLOUD_DECK_CLI="deck"
NEXTCLOUD_BASE_URL="https://my-nextcloud-host.com"
NEXTCLOUD_USERNAME="my-service-user-name"
NEXTCLOUD_APP_PASSWORD="my-service-user-app-password"

# Backwards-compatible alternative to NEXTCLOUD_BASE_URL:
# NEXTCLOUD_HOSTNAME="my-nextcloud-host.com"

HTTP_PORT="8000"
DATA_FETCH_DELAY="60"
LOG_LEVEL="INFO"
